# Host ports — must stay off the forbidden list in CLAUDE.md §5.1
FRONTEND_PORT=5180
BACKEND_PORT=8010
DB_HOST_PORT=55432
ADMINER_PORT=8090

# Postgres
POSTGRES_USER=formcoach
POSTGRES_PASSWORD=formcoach
